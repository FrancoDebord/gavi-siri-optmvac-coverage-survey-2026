# Lecture des photos par l'IA (Claude) : suggestions de valeur sur les queries (activer aussi dans Paramètres).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Connexion Microsoft 365 (Entra ID > Inscriptions d'applications) ; URI de redirection : APP_URL/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Envoi des e-mails par Microsoft Graph : MAIL_MAILER=graph ; application Entra ID avec la permission d'application Mail.Send
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER_EMAIL=
MS_GRAPH_SENDER_NAME="GAVI SIRI R2"

APP_NAME="GAVI SIRI R2"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Porto-Novo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=gavi_coverage_round_2_dashboard_queries
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Supérieur au timeout des jobs longs (RunQualityChecksJob : 3600 s), sinon un second worker les reprend.
DB_QUEUE_RETRY_AFTER=3700

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Enquête GAVI SIRI R2 ---
GAVI_SETTINGS_PATH=
GAVI_DICTIONARY_FILE=cov26c4v3.xls
GAVI_COUNTRY=bj
GAVI_DASHBOARD_REFRESH=60
GAVI_DASHBOARD_CACHE=30
ADMIN_EMAIL=admin@gavi.local
ADMIN_PASSWORD=
